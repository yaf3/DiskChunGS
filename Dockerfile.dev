# Development image on top of base dependencies
FROM casimirfeldmann/diskchungs:base AS dev

# Refresh ROS keys automatically
RUN apt-key adv --refresh-keys --keyserver keyserver.ubuntu.com || true && \
    curl -sSL 'http://keyserver.ubuntu.com/pks/lookup?op=get&search=0xC1CF6E31E6BADE8868B172B4F42ED6FBAB17C654' | apt-key add - || true

# Install Python packages for development
RUN pip3 install optuna optuna-dashboard networkx==2.8.8 opencv-python==4.10.0.84 pynput

# Install Python packages for evaluation
RUN pip3 install torchmetrics==1.5.2 evo

# Install additional development tools
RUN apt-get update && apt-get install -y \
    vim \
    gdb \
    tmux \
    htop \
    git-lfs \
    clang-format \
    && rm -rf /var/lib/apt/lists/*

# Install onnx runtime
RUN wget https://github.com/microsoft/onnxruntime/releases/download/v1.18.1/onnxruntime-linux-x64-gpu-1.18.1.tgz && \
    tar -xzf onnxruntime-linux-x64-gpu-1.18.1.tgz && \
    rm onnxruntime-linux-x64-gpu-1.18.1.tgz && \
    sudo cp -r onnxruntime-linux-x64-gpu-1.18.1/* /usr/local/ && \
    rm -rf onnxruntime-linux-x64-gpu-1.18.1 && \
    sudo ldconfig

# Install tensorrt runtime
RUN wget https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/secure/8.6.1/local_repos/nv-tensorrt-local-repo-ubuntu2004-8.6.1-cuda-11.8_1.0-1_amd64.deb && \
    os="ubuntu2004" && \
    tag="8.6.1-cuda-11.8" && \
    dpkg -i nv-tensorrt-local-repo-${os}-${tag}_1.0-1_amd64.deb && \
    cp /var/nv-tensorrt-local-repo-${os}-${tag}/*-keyring.gpg /usr/share/keyrings/ && \
    echo "Package: *\nPin: origin \"\"\nPin-Priority: 1001" > /etc/apt/preferences.d/tensorrt-local && \
    apt-get update && \
    apt-get install -y \
    tensorrt=8.6.1.6-1+cuda11.8 \
    libnvinfer8=8.6.1.6-1+cuda11.8 \
    libnvinfer-plugin8=8.6.1.6-1+cuda11.8 \
    libnvonnxparsers8=8.6.1.6-1+cuda11.8 \
    libnvinfer-bin=8.6.1.6-1+cuda11.8 \
    libnvinfer-dev=8.6.1.6-1+cuda11.8 \
    libnvinfer-plugin-dev=8.6.1.6-1+cuda11.8 \
    libnvonnxparsers-dev=8.6.1.6-1+cuda11.8 \
    libnvinfer-samples=8.6.1.6-1+cuda11.8 \
    python3-libnvinfer-dev=8.6.1.6-1+cuda11.8 \
    python3-libnvinfer=8.6.1.6-1+cuda11.8 && \
    rm nv-tensorrt-local-repo-${os}-${tag}_1.0-1_amd64.deb && \
    rm -rf /var/lib/apt/lists/*


# Get mono model
RUN mkdir -p /workspace/models && \
    wget -P /workspace/models https://huggingface.co/yuvraj108c/Depth-Anything-2-Onnx/resolve/main/depth_anything_v2_vitl.onnx

# Get stereo model
WORKDIR /workspace/models
RUN curl "https://s3.ap-northeast-2.wasabisys.com/pinto-model-zoo/338_Fast-ACVNet/fast_acvnet_plus_onnx_gridsample.tar.gz" -o resources.tar.gz && \
    tar -zxvf resources.tar.gz && \
    rm resources.tar.gz

# Update library paths
WORKDIR /workspace
RUN echo "export LD_LIBRARY_PATH=/workspace/repo/slam_deps/ORB-SLAM3/lib:\$LD_LIBRARY_PATH" >> /root/.bashrc
RUN echo "source /opt/ros/noetic/setup.bash" >> /root/.bashrc

# Create a welcome message with instructions
RUN echo '#!/bin/bash' > /workspace/welcome.sh && \
    echo 'echo "==================================================="' >> /workspace/welcome.sh && \
    echo 'echo "Welcome to the DiskChunGS Development Environment"' >> /workspace/welcome.sh && \
    echo 'echo "==================================================="' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    echo 'echo "Heavy dependencies are pre-built for you:"' >> /workspace/welcome.sh && \
    echo 'echo "- OpenCV"' >> /workspace/welcome.sh && \
    echo 'echo "- PyTorch"' >> /workspace/welcome.sh && \
    echo 'echo "- libtorch"' >> /workspace/welcome.sh && \
    echo 'echo "- ONNX Runtime"' >> /workspace/welcome.sh && \
    echo 'echo "- TensorRT"' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    echo 'echo "To build DiskChunGS:"' >> /workspace/welcome.sh && \
    echo 'echo "1. Run ./build.sh to build DiskChunGS"' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    chmod +x /workspace/welcome.sh && \
    echo "if [ -f /workspace/welcome.sh ]; then /workspace/welcome.sh; fi" >> /root/.bashrc


WORKDIR /workspace/repo

# Copy entrypoint script
COPY docker-entrypoint.sh /
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["bash"]