{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/kitti_stereo",
            "args": [
                "${workspaceFolder}/ORB-SLAM3/Vocabulary/ORBvoc.txt",
                "${workspaceFolder}/cfg/ORB_SLAM3/Stereo/KITTI/KITTI00-02.yaml",
                "${workspaceFolder}/cfg/gaussian_mapper/Stereo/KITTI/KITTI.yaml",
                "/data/kitti/data_odometry_color/dataset/sequences/00",
                "${workspaceFolder}/results/kitti/00"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "${env:DISPLAY}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}