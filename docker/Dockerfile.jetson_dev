# Development image on top of base dependencies
FROM jetson-base AS dev-jetson

# Boost serialization compatibility fix for ORB-SLAM3
RUN cp /usr/include/boost/serialization/list.hpp /usr/include/boost/serialization/list.hpp.backup && \
    sed -i 's/const boost::serialization::library_version_type library_version(/const boost::serialization::item_version_type library_version(/g' /usr/include/boost/serialization/list.hpp && \
    sed -i 's/if(boost::serialization::library_version_type(3) < library_version){/if(boost::serialization::item_version_type(3) < library_version){/g' /usr/include/boost/serialization/list.hpp


# Install Python packages for development
RUN pip3 install --index-url https://pypi.org/simple/ \
    optuna optuna-dashboard networkx==2.8.8 opencv-python==4.10.0.84 pynput

# Install Python packages for evaluation
RUN pip3 install --index-url https://pypi.org/simple/ \
    torchmetrics==1.7.4 evo

RUN pip3 install --index-url https://pypi.org/simple/ \
    numpy==1.26.4

# Install additional development tools
RUN apt-get update && apt-get install -y \
    vim \
    gdb \
    tmux \
    htop \
    git-lfs \
    clang-format \
    && rm -rf /var/lib/apt/lists/*

# RUN apt-get update && apt-get install -y \
#     python3-libnvinfer \
#     python3-libnvinfer-dev \
#     libnvinfer8 \
#     libnvinfer-dev \
#     libnvinfer-plugin8 \
#     libnvinfer-plugin-dev \
#     libnvonnxparsers8 \
#     libnvonnxparsers-dev \
#     libnvinfer-bin \
#     tensorrt \
#     && rm -rf /var/lib/apt/lists/*


# Update library paths
WORKDIR /workspace
RUN echo "export LD_LIBRARY_PATH=/workspace/repo/slam_deps/ORB-SLAM3/lib:\$LD_LIBRARY_PATH" >> /root/.bashrc

# Create a welcome message with instructions
RUN echo '#!/bin/bash' > /workspace/welcome.sh && \
    echo 'echo "==================================================="' >> /workspace/welcome.sh && \
    echo 'echo "Welcome to the DiskChunGS Development Environment"' >> /workspace/welcome.sh && \
    echo 'echo "            (Jetson ARM64 Version)"' >> /workspace/welcome.sh && \
    echo 'echo "==================================================="' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    echo 'echo "Heavy dependencies are pre-built for you:"' >> /workspace/welcome.sh && \
    echo 'echo "- OpenCV"' >> /workspace/welcome.sh && \
    echo 'echo "- PyTorch"' >> /workspace/welcome.sh && \
    echo 'echo "- libtorch"' >> /workspace/welcome.sh && \
    echo 'echo "- TensorRT (JetPack)"' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    echo 'echo "To build DiskChunGS:"' >> /workspace/welcome.sh && \
    echo 'echo "1. Run ./build.sh to build DiskChunGS"' >> /workspace/welcome.sh && \
    echo 'echo ""' >> /workspace/welcome.sh && \
    chmod +x /workspace/welcome.sh && \
    echo "if [ -f /workspace/welcome.sh ]; then /workspace/welcome.sh; fi" >> /root/.bashrc



WORKDIR /workspace/repo

# Copy entrypoint script
COPY docker/docker-entrypoint.sh /
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["bash"]